# Copy to `.env` beside this file and fill in. `.env` is gitignored — it holds the only
# host-specific configuration, so nothing else in the repo needs editing per deployment.

# The hostname Caddy obtains a certificate for. Must already resolve to this machine.
ARCHIVE_DOMAIN=archive.example.com

# Stamped into every share link. The server cannot infer this from behind a proxy.
ARCHIVE_PUBLIC_URL=https://archive.example.com

# Host directory for blobs, in-progress uploads and the SQLite database. Point this at
# the volume you actually want to fill up, and make sure PUID/PGID below own it.
ARCHIVE_DATA_DIR=/srv/thearchive/data

# The container runs as this uid/gid so files on the host are not root-owned.
# Find them with: id -u && id -g
PUID=1000
PGID=1000

# Optional overrides; the defaults are in docker-compose.yml.
#ARCHIVE_MAX_UPLOAD_BYTES=21474836480
#ARCHIVE_GC_INTERVAL_SECONDS=900
#ARCHIVE_BLOB_GRACE_SECONDS=86400
